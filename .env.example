# Copy to .env for a managed/local PostgreSQL connection, or use npm run setup:local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BETTER_AUTH_URL="http://localhost:3000"
# Generate independently for every environment; never use the placeholder below.
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
# Optional authorized production eBay application token; never commit a real token.
EBAY_ACCESS_TOKEN=""
